<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:clicker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="using:clicker.Views"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
        x:Class="clicker.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="clicker"
        SizeToContent="WidthAndHeight"
        Padding="16"
        TransparencyLevelHint="Mica"
        Background="Transparent"
        FontFamily="fonts:Inter#Inter">

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
    to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="Grid.rows > :is(Control)">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <StackPanel Spacing="5">
    <Border Margin="5" CornerRadius="10" Background="#B691E4">
      <TextBlock Margin="5" FontSize="24" HorizontalAlignment="Center" Text="Clicker"></TextBlock>
    </Border>
    <StackPanel Grid.IsSharedSizeScope="True" Spacing="5">
      <v:ClickRow Name="Row1" Label="Click 1" />
      <v:ClickRow Name="Row2" Label="Click 2" />
    </StackPanel>
    <Button Classes="accent" HorizontalAlignment="Center" Name="StartButton" Click="Start_Click">Start</Button>
    <TextBlock MinHeight="20" TextWrapping="Wrap" Name="StatusText"></TextBlock>
  </StackPanel>
</Window>
