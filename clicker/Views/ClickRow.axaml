<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="clicker.Views.ClickRow">



  <Border CornerRadius="8" Padding="10" Background="#709FB7C5">
    <Grid
      Classes="rows"
      RowSpacing="15" ColumnSpacing="5"
      ColumnDefinitions="Auto,*,Auto,Auto"
      RowDefinitions="Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Name="LabelText" ></TextBlock>
      <TextBox Grid.Row="0" Grid.Column="1"  PlaceholderText="x,y" Name="PositionBox" />
      <Button Grid.Row="0" Grid.Column="2"  Click="Get_Position" Name="GetClickPosition"></Button>
      <NumericUpDown Grid.Row="0" Grid.Column="3"  Value="1" Minimum="1" Maximum="20" Name="CountBox" />
    </Grid>
  </Border>
</UserControl>

